{
  "name": "petalbranch/toml",
  "description": "description",
  "type": "library",
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "license": "Apache-2.0",
  "autoload": {
    "psr-4": {
      "Petalbranch\\Toml\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Petalbranch",
      "email": "branch@petalmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*"
  },
  "archive": {
    "exclude": [
      "/tests"
    ]
  },
  "scripts":{
    "test-toml": "cd tests && .\\toml-test-v2.1.0-windows-amd64.exe test -toml \"1.1\" -decoder \"php toml-test-runner.php\"",
    "test-toml-encode": "cd tests && .\\toml-test-v2.1.0-windows-amd64.exe test -toml \"1.1\" -decoder \"php toml-test-runner.php\"",
    "test-toml-decode": "cd tests && .\\toml-test-v2.1.0-windows-amd64.exe test -toml \"1.1\" -decoder \"php toml-test-runner.php\""
  }
}
